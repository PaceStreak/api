# Copy to .env for local development. Never commit the copy - .gitignore
# already excludes it, and pre-commit will refuse a private key.
#
# Real values are set as environment variables on whatever runs the container.
# Every variable is prefixed PACESTREAK_ (see app/config.py).

# local | staging | production
# Production disables /docs and /openapi.json.
PACESTREAK_ENVIRONMENT=local

# Explicit origins, comma-separated. Never "*": this API sends credentials, and
# browsers reject a wildcard origin on a credentialed response - the result is
# a blocked request, not a permissive one. Settings refuses to hold "*".
#
# Local Astro dev server:
PACESTREAK_CORS_ALLOW_ORIGINS=["http://localhost:4321"]
# Production:
# PACESTREAK_CORS_ALLOW_ORIGINS=["https://app.pacestreak.com"]

# The session cookie must be readable by both app.pacestreak.com and
# api.pacestreak.com, so it is scoped to the registrable domain. Leave unset
# locally, where everything is on localhost.
# PACESTREAK_COOKIE_DOMAIN=pacestreak.com
