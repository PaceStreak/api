# Copy to .dev.vars (gitignored) for `wrangler dev`. Names only: never commit values.
# Generate local values with: pnpm tsx scripts/dev-secrets.ts
ENVIRONMENT=development
MAILER=console
# 0 (production today): no outgoing email; 1 sends through MAILER (console prints codes to this log)
EMAIL_ENABLED=0
# MAILER is console | smtp | brevo | cloudflare. Secrets below: never commit a value.
# MAILER=brevo: a Brevo API key (xkeysib-...)
BREVO_API_KEY=
# MAILER=smtp: Brevo SMTP login and SMTP key (xsmtpsib-...); host and port default to smtp-relay.brevo.com:587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 skips the per-IP minute limits (development only) for the app's e2e suite
IP_LIMITS_OFF=0
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
JWT_KEYS=
PEPPER=
DATA_KEY=
VAPID_PRIVATE_JWK=
VAPID_PUBLIC_KEY=
TURNSTILE_SECRET_KEY=
