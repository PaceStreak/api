# Copy to .env and adjust. Compose reads .env automatically.
#
#   cp .env.example .env
#
# Every value below is also the built-in default in compose.yaml, so the stack
# runs without this file. It exists to document what is tunable.

# --- how the API runs -------------------------------------------------------

# dev  -> fastapi dev  (reload on, single process)
# prod -> fastapi run  (reload off, optional workers)
# compose.override.yaml forces dev for `docker compose up`.
APP_MODE=prod

APP_MODULE=app.main:app
APP_PORT=8000

# Port on the host. Change it if 8000 is taken.
API_PORT=8000

# Path the container healthcheck requests.
API_HEALTH_PATH=/health

# Worker processes. Leave empty on a platform that scales by running more
# containers (Cloud Run, Fly, Railway) - workers inside a replicated container
# multiply memory for nothing. Only meaningful with APP_MODE=prod.
WEB_CONCURRENCY=

# Addresses uvicorn will trust X-Forwarded-* headers from. Empty means trust
# none. Do not set "*" on anything reachable from the internet: it lets a
# caller forge their own client IP.
FORWARDED_ALLOW_IPS=

# --- postgres ---------------------------------------------------------------

POSTGRES_USER=pacestreak
POSTGRES_PASSWORD=pacestreak
POSTGRES_DB=pacestreak

# Host-side port, development only. Bound to 127.0.0.1 by the override file.
POSTGRES_HOST_PORT=5432

# --- redis ------------------------------------------------------------------

REDIS_HOST_PORT=6379

# Run `alembic upgrade head` before starting the server. Off by default so the
# entrypoint never runs DDL on every boot - with more than one replica, every
# replica would run it at once. `make migrate` is the manual alternative.
RUN_MIGRATIONS=0

# --- auth ---------------------------------------------------------------

ENVIRONMENT=development
DEBUG=True

DATABASE_URL=postgresql+asyncpg://pacestreak:pacestreak@postgres:5432/pacestreak
REDIS_URL=redis://redis:6379/0

# RS256 keypair the access tokens are signed with. `make keys` generates both
# into ./keys, which is git-ignored - see README.md.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=api.pacestreak.com
JWT_AUDIENCE=pacestreak

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
USER_CACHE_TTL_SECONDS=60

# Domain=pacestreak.com is what lets app.pacestreak.com send the refresh
# cookie to api.pacestreak.com - see CLAUDE.md and ARCHITECTURE.md. Left unset
# here because there is no shared registrable domain between localhost ports.
COOKIE_DOMAIN=
# Set True in production. False here because local development is plain
# HTTP, and the __Secure- cookie prefix (used automatically once this is
# True) is rejected by the browser without it.
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# The frontend origin(s) allowed to send credentialed requests here. No
# wildcard is accepted - see app/config.py. In production this must be
# exactly https://app.pacestreak.com.
CORS_ORIGINS=http://localhost:5173

# Public URL of app.pacestreak.com, which handles the links this API emails
# out (verify-email, reset-password).
FRONTEND_URL=http://localhost:5173
# Base URL of this API as the outside world sees it; used for calendar feed links.
PUBLIC_API_URL=http://localhost:8000
REQUIRE_VERIFIED_EMAIL=False

# console logs outbound mail instead of sending it - the default, so a fresh
# checkout needs no mail provider. No third-party email API is wired in.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@pacestreak.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Fernet key encrypting totp_secret at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production - app/main.py refuses to start without it there.
TOTP_ENCRYPTION_KEY=

# Requests per window, per client IP, backed by Redis - see app/ratelimit.py.
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_MFA_VERIFY=10/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_PASSWORD_EMAIL=3/minute
